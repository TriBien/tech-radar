# --- Crawler / LLM enrichment (all optional) ---
# OpenAI-compatible endpoint. Defaults to GitHub Models.
# LLM_BASE_URL=https://models.github.ai/inference
# LLM_MODEL=openai/gpt-4o-mini
# LLM_API_KEY=...            # in Actions, GITHUB_TOKEN is used automatically
# MAX_LLM_ARTICLES=40        # cap per run to control cost/latency
# CRAWL_DAYS=2               # how far back to look for new items
